# Primary & Backup Gemini API Keys (3 ways to specify):
# Option A (Separate lines):
# GEMINI_API_KEY=AIzaSyPrimary...
# GEMINI_API_KEY_BACKUP_1=AIzaSyBackup1...
# GEMINI_API_KEY_BACKUP_2=AIzaSyBackup2...
#
# Option B (Comma-separated in single line):
# GEMINI_API_KEY=AIzaSyPrimary..., AIzaSyBackup1..., AIzaSyBackup2...

GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP_1=
GEMINI_API_KEY_BACKUP_2=

# Optional: Groq API Key
GROQ_API_KEY=

# Meta Graph API Credentials (for Instagram & Facebook Auto-Posting)
META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
FACEBOOK_PAGE_ID=
